{
  "name": "glpi-whatsapp",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy:static",
    "copy:static": "mkdir -p dist/web-server && cp src/web-server/index.html dist/web-server/",
