    "express": "^5.2.1",
    "pino": "^10.3.1",
    "puppeteer": "^24.37.5",
    "qrcode-terminal": "^0.12.0",
    "rimraf": "^6.1.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
