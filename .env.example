# ===========================================
# WHATSAPP CONFIGURATION
# ===========================================
# (Required) Exact name of the WhatsApp group to monitor
WHATSAPP_GROUP_NAME=

# (Optional) Directory for WhatsApp session files
# Default: ./.wa_session
WHATSAPP_SESSION_DIR=./.wa_session

# (Optional) Run Puppeteer in headless mode
# Default: true
WHATSAPP_HEADLESS=true

# (Optional) Path to Chrome/Chromium executable for Puppeteer
WHATSAPP_PUPPETEER_EXECUTABLE_PATH=

# (Optional) WhatsApp client ID
WHATSAPP_CLIENT_ID=

# ===========================================
# GLPI 10 CONFIGURATION (REST API)
# ===========================================
# (Required) GLPI base URL (without /apirest.php)
GLPI_BASE_URL=

# ===========================================
# GLPI REST API Authentication (choose ONE option)
# ===========================================
# Option A: User Token (recommended - no 2FA issues)
# Get it from: Preferences → Remote access key → API token
GLPI_USER_TOKEN=

# Option B: Login + Password (may require 2FA if enabled)
GLPI_USER=
GLPI_PASSWORD=

# (Optional) App-Token for API access
# Ask your GLPI admin if this is required
GLPI_APP_TOKEN=

# ===========================================
# GLPI REST API User & Profile Settings
# ===========================================
# (Optional) Default requester for tickets (username or full name)
GLPI_DEFAULT_REQUESTER=

GLPI_USER_PASSWORD=1234567****Mp

# (Optional) GLPI Profile ID for creating tickets
GLPI_PROFILE_ID=

# (Optional) GLPI Profile name for creating tickets
# Default: OPERADOR
GLPI_PROFILE_NAME=OPERADOR

# (Optional) Search Profile ID for user lookups
GLPI_SEARCH_PROFILE_ID=

# (Optional) Search Profile name for user lookups
GLPI_SEARCH_PROFILE_NAME=

# (Optional) Comma-separated field IDs for DNI lookup
# Example: 100,101,102
GLPI_DNI_FIELD_IDS=

# (Optional) Default category ID for tickets
# Default: 1
GLPI_DEFAULT_CATEGORY_ID=1

# ===========================================
# GLPI WEB API (CON COOKIES Y MFA)
# ===========================================
# Enable web API with cookie-based authentication (supports MFA)
# Set to true if your GLPI requires MFA and you don't have API token
GLPI_USE_WEB_API=false

# (Optional) Path to store GLPI session cookies
# Default: ./.glpi_cookies.json
GLPI_COOKIE_FILE=./.glpi_cookies.json

# (Optional) GLPI login URL (auto-detected from GLPI_BASE_URL if not set)
# Example: https://portalogti.mpfn.gob.pe/front/login.php
GLPI_LOGIN_URL=

# ===========================================
# WEB SERVER (DASHBOARD)
# ===========================================
# Enable web dashboard for managing authentication
WEB_SERVER_ENABLED=true

# (Optional) Dashboard port
# Default: 3000
WEB_SERVER_PORT=3000

# ===========================================
# TECHNICIANS CONFIGURATION
# ===========================================
# (Optional) JSON inline mapping of phone to technician info
# Format: { "phone_number": ["celular", "glpi_id"] }
# Example: { "51997314528": ["51997314528", "27164"] }
TECHNICIAN_BY_PHONE=

# (Optional) Path to JSON file with technician mapping
# Default: ./numbers-map.json
TECHNICIAN_BY_PHONE_PATH=./numbers-map.json

# ===========================================
# CATEGORIES CONFIGURATION
# ===========================================
# (Optional) Path to categories JSON file
# Default: ./categories.json
CATEGORIES_PATH=./categories.json

# (Optional) Alias for CATEGORIES_PATH
KNOWLEDGE_BASE_PATH=
